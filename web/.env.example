APP_NAME="TMC CampusLF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tmc_campuslf
DB_USERNAME=root
DB_PASSWORD=88888

SESSION_DRIVER=file
SESSION_LIFETIME=30
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tmc.test"
MAIL_FROM_NAME="${APP_NAME}"

# For inbox delivery, use a Gmail account with 2-Step Verification and an
# app password. Do not put a normal Gmail password here.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=your-sender@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM_ADDRESS=your-sender@gmail.com

TMC_EMAIL_DOMAIN=gmail.com
TMC_DEFAULT_ADMIN_EMAIL=admin@tmc.test
TMC_DEFAULT_ADMIN_PASSWORD=
